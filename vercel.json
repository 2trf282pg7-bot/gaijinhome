{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.gaijinhome.com"
        }
      ],
      "destination": "https://gaijinhome.com/:path*",
      "permanent": true
    },
    {
      "source": "/drafts/:slug.html",
      "destination": "/articles/:slug",
      "permanent": true
    },
    {
      "source": "/drafts/:slug",
      "destination": "/articles/:slug",
      "permanent": true
    },
    {
      "source": "/guide-complete",
      "destination": "/full-guide",
      "permanent": true
    },
    {
      "source": "/guide-complete.html",
      "destination": "/full-guide",
      "permanent": true
    },
    {
      "source": "/guide-no-guarantor",
      "destination": "/no-guarantor",
      "permanent": true
    },
    {
      "source": "/guide-no-guarantor.html",
      "destination": "/no-guarantor",
      "permanent": true
    },
    {
      "source": "/guide-rejection",
      "destination": "/rejected",
      "permanent": true
    },
    {
      "source": "/guide-rejection.html",
      "destination": "/rejected",
      "permanent": true
    },
    {
      "source": "/guide-hidden-costs",
      "destination": "/hidden-costs",
      "permanent": true
    },
    {
      "source": "/guide-hidden-costs.html",
      "destination": "/hidden-costs",
      "permanent": true
    },
    {
      "source": "/guide-osaka-kansai",
      "destination": "/osaka",
      "permanent": true
    },
    {
      "source": "/guide-osaka-kansai.html",
      "destination": "/osaka",
      "permanent": true
    },
    {
      "source": "/guide-visa-breakdown",
      "destination": "/visa-guide",
      "permanent": true
    },
    {
      "source": "/guide-visa-breakdown.html",
      "destination": "/visa-guide",
      "permanent": true
    },
    {
      "source": "/guide-germany-immigration",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/guide-germany-immigration.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/guides",
      "destination": "/articles",
      "permanent": true
    },
    {
      "source": "/guides.html",
      "destination": "/articles",
      "permanent": true
    },
    {
      "source": "/listings",
      "destination": "/articles",
      "permanent": true
    },
    {
      "source": "/listings.html",
      "destination": "/articles",
      "permanent": true
